# Normalize line endings across machines.
# Git stores text files as LF in the repo and checks them out with the
# platform's native endings, so line-ending differences never show up as
# changes again. Binary files are auto-detected and left untouched.
* text=auto

# Keep development files out of the release zip built with `git archive`.
/.gitattributes export-ignore
/.gitignore     export-ignore
/README.md      export-ignore
